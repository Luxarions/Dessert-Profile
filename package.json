{
  "name": "dessert",
  "version": "2.0.0",
  "description": "Lightweight UI Logic Library with prefix DESSERT",
  "type": "module",
  "types": "./types/dessert.d.ts",
  "main": "dist/dessert.cjs.js",
  "module": "dist/dessert.esm.js",
  "browser": "dist/dessert.umd.js",
  "unpkg": "dist/dessert.umd.min.js",
  "jsdelivr": "dist/dessert.umd.min.js",
  "exports": {
    ".": {
      "types": "./types/dessert.d.ts",
      "import": "./dist/dessert.esm.js",
      "require": "./dist/dessert.cjs.js",
      "default": "./dist/dessert.esm.js"
    },
    "./loader": {
      "types": "./types/loader.d.ts",
      "import": "./dist/loader.esm.js",
      "require": "./dist/loader.cjs.js",
      "default": "./dist/loader.esm.js"
    },
    "./css": "./dist/dessert.css",
    "./css/min": "./dist/dessert.min.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/build-css.js && node scripts/build-dist.js",
    "build:js": "node scripts/build-dist.js",
    "build:css": "node scripts/build-css.js",
    "test": "node test/run.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
